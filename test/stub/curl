#!/usr/bin/env python3
"""Stands in for curl: records its arguments as JSON, then forwards to CURL_FORWARD_URL if set."""

import json
import os
import sys

args = sys.argv[1:]
with open(os.environ["CURL_ARGS"], "w", encoding="utf-8") as f:
    json.dump(args, f)

forward_url = os.environ.get("CURL_FORWARD_URL")
if forward_url:
    real = os.environ["CURL_REAL"]
    os.execv(real, [real, *args[:-1], forward_url])
