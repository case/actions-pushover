#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

for tool in curl python3; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "Error: $tool not found on PATH." >&2
    exit 1
  fi
done

if ! python3 -c 'import sys; sys.exit(sys.version_info < (3, 14))'; then
  echo "Error: tests need Python 3.14 or later, found $(python3 --version). Run bin/setup." >&2
  exit 1
fi

exec python3 -m unittest discover -s test -v
